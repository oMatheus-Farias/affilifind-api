generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @db.Uuid
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  affiliateCredentials AffiliateCredential[]

  @@map("users")
}

model AffiliateCredential {
  id          String   @id @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  platform    String
  credentials Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("affiliate_credentials")
}

model Promotion {
  id                 String   @id @db.Uuid
  platform           String
  externalId         String   @unique @map("external_id")
  title              String
  description        String?  @db.Text
  category           String?
  originalPrice      Float?   @map("original_price")
  currentPrice       Float    @map("current_price")
  maxPrice           Float?   @map("max_price")
  discountPercentage Float?   @map("discount_percentage")
  imageUrl           String   @map("image_url")
  affiliateUrl       String   @map("affiliate_url")
  originalProductUrl String?  @map("original_product_url")
  salesCount         Int      @default(0) @map("sales_count")
  rating             Float    @default(5.0)
  commissionAmount   Float?   @map("commission_amount")
  shopName           String?  @map("shop_name")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("promotions")
}

model SearchKeyword {
  id         String    @id @db.Uuid
  keyword    String    @unique
  category   String
  isActive   Boolean   @default(true) @map("is_active")
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("search_keywords")
}
