{
  "name": "affilifind-api",
  "version": "1.0.0",
  "packageManager": "pnpm@11.13.1",
  "type": "module",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "node --env-file=.env --import @swc-node/register/esm-register --watch src/main/server.ts",
    "build": "prisma generate && tsup src/main/server.ts --format esm --out-dir dist",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "postinstall": "prisma generate",
    "seed:keywords": "tsx src/infra/scripts/seedKeywords.ts",
    "job:shopee-sync": "node --env-file=.env --import @swc-node/register/esm-register src/infra/scripts/runShopeeSyncJob.ts",
    "job:telegram-promotions": "node --env-file=.env --import @swc-node/register/esm-register src/infra/scripts/runTelegramPromotionsJob.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.13.1",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "21.0.2",
    "@commitlint/config-conventional": "21.0.2",
    "@eslint/js": "10.0.1",
    "@swc-node/register": "^1.11.1",
    "@types/node": "25.9.2",
    "@types/pg": "8.20.0",
    "eslint": "10.4.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-simple-import-sort": "13.0.0",
    "globals": "17.6.0",
    "husky": "9.1.7",
    "lint-staged": "17.0.7",
    "prettier": "3.8.4",
    "prisma": "7.8.0",
    "tsup": "8.5.1",
    "tsx": "4.19.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.61.0"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "axios": "1.18.0",
    "dotenv": "17.4.2",
    "fastify": "5.8.5",
    "node-cron": "^4.6.0",
    "pg": "8.21.0",
    "reflect-metadata": "0.2.2",
    "uuidv7": "^1.2.1",
    "zod": "4.4.3"
  }
}
